    "directory": "local-lab/held-out-saas",
    "dockerComposeFile": "docker-compose.yml",
    "healthPath": "/health",
    "internalPort": 3000,
    "inProcessEntry": "server.ts",
    "startFunction": "startHeldOutSaasServer",
    "sqlDialect": "sqlite",
    "patchDirectory": "patches"
  },
