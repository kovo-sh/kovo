{
  "version": 1,
  "comment": "Past false-positive / over-claim archetypes replayed through the shared Oracle invariants. Every archetype MUST be dismissed (satisfied=false). Defensive QA only: synthetic transcript shapes, no live targets.",
  "archetypes": [
    {
      "id": "2fa-without-enrollment",
      "title": "OTP endpoint returns 2xx on an account with no enrollment",
      "assessor": "mfa",
      "expectedDismissal": "no control read shows the account is enrolled",
      "input": {
        "impactClass": "other",
        "steps": [
          {
            "id": "pre",
            "arm": "control",
            "method": "GET",
            "route": "/api/account",
            "pathAndQuery": "/api/account",
            "status": 401,
            "actor": { "handle": "member_a", "role": "member", "tenant": "acme", "auth": "cookie", "sameSite": "lax" },
            "body": "{\"error\":\"mfa_required\"}"
          },
          {
            "id": "probe",
            "arm": "probe",
            "method": "POST",
            "route": "/api/2fa/verify",
            "pathAndQuery": "/api/2fa/verify",
            "status": 200,
            "actor": { "handle": "member_a", "role": "member", "tenant": "acme", "auth": "cookie", "sameSite": "lax" },
            "requestJson": { "code": "000000" },
            "json": { "ok": true, "verified": true }
          },
          {
            "id": "post",
            "arm": "probe",
            "method": "GET",
            "route": "/api/account",
            "pathAndQuery": "/api/account",
            "status": 200,
            "actor": { "handle": "member_a", "role": "member", "tenant": "acme", "auth": "cookie", "sameSite": "lax" },
            "json": { "id": "acct_1", "name": "Member A", "twofa_enabled": false }
          }
        ]
      }
    },
    {
      "id": "amount-negative-echo",
      "title": "Checkout accepts a negative amount and echoes it in the response",
      "assessor": "business_logic",
      "expectedDismissal": "a mutation response echo is not a state delta",
      "input": {
        "impactClass": "business_logic",
        "steps": [
          {
            "id": "probe",
            "arm": "probe",
            "method": "POST",
            "route": "/api/checkout",
            "pathAndQuery": "/api/checkout",
            "status": 200,
            "actor": { "handle": "member_a", "role": "member", "tenant": "acme", "auth": "cookie", "sameSite": "lax" },
            "requestJson": { "amount": -1, "currency": "USD" },
            "json": { "ok": true, "amount": -1, "currency": "USD" }
          }
        ]
      }
    },
    {
      "id": "bfla-2xx-only",
      "title": "Lower role receives a 2xx from an admin read route (no differential, no data)",
      "assessor": "bfla",
      "expectedDismissal": "read-only proof lacks impact evidence",
      "input": {
        "impactClass": "bfla",
        "requiredRole": "admin",
        "steps": [
          {
            "id": "probe",
            "arm": "probe",
            "method": "GET",
            "route": "/api/admin/users",
            "pathAndQuery": "/api/admin/users",
            "status": 200,
            "actor": { "handle": "viewer_a", "role": "viewer", "tenant": "acme", "auth": "cookie", "sameSite": "lax" },
            "json": { "ok": true, "users": [] }
          }
        ]
      }
    },
    {
      "id": "echo-mass-assign",
      "title": "Protected role field is echoed by PATCH but never persisted",
      "assessor": "mass_assignment",
      "expectedDismissal": "no injected field was read back from the server",
      "input": {
        "impactClass": "mass_assignment",
        "steps": [
          {
            "id": "before",
            "arm": "control",
            "method": "GET",
            "route": "/api/users/42",
            "pathAndQuery": "/api/users/42",
            "status": 200,
            "actor": { "handle": "member_a", "role": "member", "tenant": "acme", "auth": "cookie", "sameSite": "lax" },
            "json": { "id": "42", "role": "member", "tenant_id": "acme" }
          },
          {
            "id": "probe",
            "arm": "probe",
            "method": "PATCH",
            "route": "/api/users/42",
            "pathAndQuery": "/api/users/42",
            "status": 200,
            "actor": { "handle": "member_a", "role": "member", "tenant": "acme", "auth": "cookie", "sameSite": "lax" },
            "requestJson": { "role": "admin" },
            "json": { "ok": true, "role": "admin" }
          },
          {
            "id": "after",
            "arm": "control",
            "method": "GET",
            "route": "/api/users/42",
            "pathAndQuery": "/api/users/42",
            "status": 200,
            "actor": { "handle": "member_a", "role": "member", "tenant": "acme", "auth": "cookie", "sameSite": "lax" },
            "json": { "id": "42", "role": "member", "tenant_id": "acme" }
          }
        ]
      }
    },
    {
      "id": "bearer-csrf",
      "title": "State-changing request is authenticated with a Bearer token (not CSRF-able)",
      "assessor": "csrf",
      "expectedDismissal": "cross-site form cannot attach bearer credentials",
      "input": {
        "impactClass": "csrf",
        "targetOrigin": "https://acme.example",
        "steps": [
          {
            "id": "probe",
            "arm": "probe",
            "method": "POST",
            "route": "/api/transfer",
            "pathAndQuery": "/api/transfer",
            "status": 200,
            "actor": { "handle": "member_a", "role": "member", "tenant": "acme", "auth": "bearer", "sameSite": null },
            "requestHeaders": { "origin": "https://evil.example" },
            "requestJson": { "amount": 10, "to": "acct_2" },
            "json": { "ok": true, "amount": 10 }
          }
        ]
      }
    },
    {
      "id": "public-route-tenant-canary",
      "title": "Public share route serves a canary to another tenant (by design, no private data)",
      "assessor": "authorization",
      "expectedDismissal": "route declares itself public and exposes no owner-scoped private attribute",
      "input": {
        "impactClass": "authorization",
        "steps": [
          {
            "id": "other_tenant",
            "arm": "control",
            "method": "GET",
            "route": "/api/public/docs/123",
            "pathAndQuery": "/api/public/docs/123",
            "status": 200,
            "actor": { "handle": "member_b", "role": "member", "tenant": "acme-b", "auth": "cookie", "sameSite": "lax" },
            "json": { "slug": "vendor-info", "canary": "rb_fake_public_canary" }
          },
          {
            "id": "probe",
            "arm": "probe",
            "method": "GET",
            "route": "/api/public/docs/123",
            "pathAndQuery": "/api/public/docs/123",
            "status": 200,
            "actor": { "handle": "member_a", "role": "member", "tenant": "acme-a", "auth": "cookie", "sameSite": "lax" },
            "json": { "slug": "vendor-info", "canary": "rb_fake_public_canary" }
          }
        ]
      }
    },
  {
    "id": "cart-coupon-echo-without-checkout",
    "title": "Coupon apply echoes a discount on a cart but no checkout total or payment moves",
    "assessor": "business_logic",
    "expectedDismissal": "a mutation response echo of a writable cart/discount field is not a checkout financial invariant (no boundary, no repeated terminal transition, no protected amount persisted, no declared invariant event)",
    "input": {
      "impactClass": "business_logic",
      "steps": [
        {
          "id": "apply",
          "arm": "probe",
          "method": "POST",
          "route": "/api/carts/:cartId/coupons",
          "pathAndQuery": "/api/carts/cart_1/coupons",
          "status": 200,
          "actor": { "handle": "member_a", "role": "member", "tenant": "store-a", "auth": "cookie", "sameSite": "lax" },
          "requestJson": { "couponCode": "WELCOME10" },
          "json": { "ok": true, "discount": 1000 }
        }
      ]
    }
  },
  {
    "id": "shared-cart-row-collision",
    "title": "A concurrent worker's cart total is visible in the after-read of an unrelated quantity probe",
    "assessor": "business_logic",
    "expectedDismissal": "the delta field reflects no value this probe sent, so a concurrent writer on the shared cart row cannot be excluded",
    "input": {
      "impactClass": "business_logic",
      "steps": [
        {
          "id": "before",
          "arm": "probe",
          "method": "GET",
          "route": "/api/carts/:cartId",
          "pathAndQuery": "/api/carts/cart_1",
          "status": 200,
          "actor": { "handle": "member_a", "role": "member", "tenant": "store-a", "auth": "cookie", "sameSite": "lax" },
          "json": { "amount": 1200 }
        },
        {
          "id": "add",
          "arm": "probe",
          "method": "POST",
          "route": "/api/carts/:cartId/items",
          "pathAndQuery": "/api/carts/cart_1/items",
          "status": 201,
          "actor": { "handle": "member_a", "role": "member", "tenant": "store-a", "auth": "cookie", "sameSite": "lax" },
          "requestJson": { "qty": 7, "lineNote": "probe-line-zzz" },
          "json": { "ok": true }
        },
        {
          "id": "after",
          "arm": "probe",
          "method": "GET",
          "route": "/api/carts/:cartId",
          "pathAndQuery": "/api/carts/cart_1",
          "status": 200,
          "actor": { "handle": "member_a", "role": "member", "tenant": "store-a", "auth": "cookie", "sameSite": "lax" },
          "json": { "amount": 9900 }
        }
      ]
    }
  },
{
  "id": "catalog-canary-public-read",
  "title": "Anonymous storefront read returns the owner reference body including a store-scoped note canary",
  "assessor": "authorization",
  "expectedDismissal": "anonymous body identical to the owner reference on a public storefront page is publicness, not a cross-tenant crossing",
  "input": {
    "impactClass": "authorization",
    "steps": [
      {
        "id": "ctl_none",
        "arm": "control",
        "method": "GET",
        "route": "/api/v1/stores/:storeId/catalog/:productId",
        "pathAndQuery": "/api/v1/stores/000000/catalog/204",
        "status": 200,
        "actor": {
          "handle": null,
          "role": null,
          "tenant": null,
          "auth": "none",
          "sameSite": null
        },
        "json": {
          "store": "000000",
          "viewer": "000000",
          "product": null,
          "memberNote": ""
        }
      },
      {
        "id": "owner_ref",
        "arm": "control",
        "method": "GET",
        "route": "/api/v1/stores/:storeId/catalog/:productId",
        "pathAndQuery": "/api/v1/stores/9ca676/catalog/204",
        "status": 200,
        "actor": {
          "handle": "persona_a",
          "role": "owner",
          "tenant": "9ca676",
          "auth": "cookie",
          "sameSite": "lax"
        },
        "json": {
          "store": "9ca676",
          "viewer": "9ca676",
          "product": {
            "id": "204",
            "title": "Item 1",
            "price": 1200
          },
          "memberNote": "loyalty rbc_9ca676_0123456789ab"
        }
      },
      {
        "id": "probe_anon",
        "arm": "probe",
        "method": "GET",
        "route": "/api/v1/stores/:storeId/catalog/:productId",
        "pathAndQuery": "/api/v1/stores/9ca676/catalog/204",
        "status": 200,
        "actor": {
          "handle": null,
          "role": null,
          "tenant": null,
          "auth": "none",
          "sameSite": null
        },
        "json": {
          "store": "9ca676",
          "viewer": "9ca676",
          "product": {
            "id": "204",
            "title": "Item 1",
            "price": 1200
          },
          "memberNote": "loyalty rbc_9ca676_0123456789ab"
        }
      }
    ]
  }
},
{
  "id": "catalog-item-owner-reference",
  "title": "Non-owner tenant reads a catalog item identical to the owner reference (store token in body)",
  "assessor": "authorization",
  "expectedDismissal": "an item read byte-identical to the owner reference is a public catalog object, not tenant-scoped data",
  "input": {
    "impactClass": "authorization",
    "steps": [
      {
        "id": "owner_ref",
        "arm": "control",
        "method": "GET",
        "route": "/api/v1/catalog/:productId",
        "pathAndQuery": "/api/v1/catalog/201",
        "status": 200,
        "actor": {
          "handle": "persona_a",
          "role": "owner",
          "tenant": "9ca676",
          "auth": "cookie",
          "sameSite": "lax"
        },
        "json": {
          "id": 201,
          "external_id": "201",
          "store_id": "9ca676",
          "title": "Item 2",
          "price": 1700,
          "stock": 5,
          "body_html": "<p>Quality item 2</p>"
        }
      },
      {
        "id": "ctl_list",
