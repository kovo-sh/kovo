          "role": "owner",
          "tenant": "6ea2e7",
          "auth": "cookie",
          "sameSite": "lax"
        },
        "json": {
          "products": [
            {
              "external_id": "205",
              "title": "Item 1",
              "price": 1200,
              "stock": 5
            }
          ]
        }
      },
      {
        "id": "probe_foreign",
        "arm": "probe",
        "method": "GET",
        "route": "/api/v1/catalog/:productId",
        "pathAndQuery": "/api/v1/catalog/201",
        "status": 200,
        "actor": {
          "handle": "persona_b",
          "role": "owner",
          "tenant": "6ea2e7",
          "auth": "cookie",
          "sameSite": "lax"
        },
        "json": {
          "id": 201,
          "external_id": "201",
          "store_id": "9ca676",
          "title": "Item 2",
          "price": 1700,
          "stock": 5,
          "body_html": "<p>Quality item 2</p>"
        }
      }
    ]
  }
},
