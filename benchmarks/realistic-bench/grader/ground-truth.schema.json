{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GroundTruth",
  "type": "object",
  "required": [
    "schemaVersion",
    "app",
    "seed",
    "seedSet",
    "vulns",
    "decoys",
    "chains"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "app": {
      "type": "string"
    },
    "seed": {
      "type": "number"
    },
    "seedSet": {
      "enum": [
        "dev",
        "held-out"
      ]
    },
    "vulns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "siteId",
          "title",
          "vulnClass",
          "cwe",
          "severity",
          "endpoints",
          "triggerEndpoints",
          "params",
          "oracle",
          "rootCause"
        ],
        "properties": {
          "siteId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "vulnClass": {
            "type": "string"
          },
          "cwe": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "endpoints": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "method",
                "path",
                "routeKey"
              ],
              "properties": {
                "method": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "routeKey": {
                  "type": "string"
                }
              }
            }
          },
          "triggerEndpoints": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "method",
                "path",
                "routeKey"
              ],
              "properties": {
                "method": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "routeKey": {
                  "type": "string"
                }
              }
            }
          },
          "params": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "oracle": {
            "type": "object",
            "required": [
              "kinds",
              "routeKeys"
            ],
            "properties": {
              "kinds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "routeKeys": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "rootCause": {
            "type": "object",
            "required": [
              "file",
              "symbol"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "symbol": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "decoys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "siteId",
          "title",
          "vulnClass",
          "cwe",
          "severity",
          "endpoints",
          "triggerEndpoints",
          "params",
          "oracle",
          "rootCause"
        ],
        "properties": {
          "siteId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "vulnClass": {
            "type": "string"
          },
          "cwe": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "endpoints": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "method",
                "path",
                "routeKey"
              ],
              "properties": {
                "method": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "routeKey": {
                  "type": "string"
                }
              }
            }
          },
          "triggerEndpoints": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "method",
                "path",
                "routeKey"
              ],
              "properties": {
                "method": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "routeKey": {
                  "type": "string"
                }
              }
            }
          },
          "params": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "oracle": {
            "type": "object",
            "required": [
              "kinds",
              "routeKeys"
            ],
            "properties": {
              "kinds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "routeKeys": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "rootCause": {
            "type": "object",
            "required": [
              "file",
              "symbol"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "symbol": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "chains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "siteIds",
          "severity"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "siteIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "severity": {
            "type": "string"
          }
        }
      }
    }
  }
}
