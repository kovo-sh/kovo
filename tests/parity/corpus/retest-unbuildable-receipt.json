  "canonicalLabel": {
    "cwe": "CWE-0",
    "category": "other",
    "title": "Unclassifiable alert acknowledgement boundary",
    "impact": "Observed POST status response without persisted readback.",
    "claimedImpact": "other",
    "claimedBoundary": "access",
    "vulnClass": "other"
  },
  "freeTextLabel": {
    "title": "Unbuildable receipt retest"
  },
  "paths": {
    "replay": false,
    "floorReceipt": false,
    "evaluateClaims": false,
    "composite": false,
    "floorInjectionRecipe": false,
    "retest": true
  },
  "expected": {
    "confirmed": false
  },
  "retest": {
    "scenario": "unbuildable_receipt",
    "expectedVerdict": "inconclusive",
    "expectedFailureReason": "receipt_unbuildable"
  },
