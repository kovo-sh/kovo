    "claimedImpact": "authorization",
    "claimedBoundary": "access",
    "vulnClass": "bola"
  },
  "freeTextLabel": {
    "title": "Cross-tenant invoice read retest with expired session token"
  },
  "paths": {
    "replay": false,
    "floorReceipt": false,
    "evaluateClaims": false,
    "composite": false,
    "floorInjectionRecipe": false,
    "retest": true
