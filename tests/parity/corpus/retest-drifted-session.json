      "headerValue": "Bearer parity-owner-a-token"
    },
    {
      "handle": "viewer_b",
      "roleLabel": "viewer (tenant-b)",
      "role": "viewer",
      "tenant": "tenant-b",
      "auth": "bearer",
      "headerName": "authorization",
      "headerValue": "Bearer parity-viewer-b-token"
    },
    {
      "handle": "member_b",
      "roleLabel": "member (tenant-b)",
      "role": "member",
      "tenant": "tenant-b",
      "auth": "bearer",
      "headerName": "authorization",
      "headerValue": "Bearer parity-member-b-expired-token"
    }
  ],
  "exchanges": [
    {
      "id": "entitled",
      "arm": "control",
      "role": "control",
      "method": "GET",
      "pathAndQuery": "/api/invoices/inv_victim_9",
      "persona": "owner_a",
      "status": 200,
      "mediaType": "application/json",
      "responseHeaders": { "content-type": "application/json" },
      "body": "{\"id\":\"inv_victim_9\",\"owner_id\":\"owner_a\",\"tenant_id\":\"tenant-a\",\"email\":\"billing@tenant-a.example\",\"amount_cents\":89000}"
