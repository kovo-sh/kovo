{
  "id": "retest-drifted-session",
  "side": "retest",
  "archetype": "retest-drifted-session",
  "description": "Cross-tenant BOLA retest where the authenticated probe persona session expired (HTTP 401) while baseline controls succeeded. All three retest engines MUST return inconclusive with failureReason=session_drifted, NEVER fixed.",
  "canonicalLabel": {
    "cwe": "CWE-639",
    "category": "bola",
    "title": "Cross-tenant BOLA read on victim invoice",
