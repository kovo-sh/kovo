    "assertionsJq": "{ controlPassed: (.steps.entitled.status == 200 and .steps.denied.status == 403), confirmed: (.steps.prb.status == 200 and .steps.prb.json.email == .steps.entitled.json.email), observed: (.steps.prb.status | tostring), expected: \"403\" }"
  },
  "claims": [
