{
  "id": "r3-11-cross-tenant-read-tp",
  "side": "tp",
  "archetype": "r3-11-cross-tenant-read-identity",
  "description": "R3-11 TP: cross_tenant_read receipt class confirms cross-tenant authorization boundary violation and binds cleanly to CWE-639 / broken-access-control (never falling through to CWE-200 / misconfig-exposure) across replay, floor receipt, evaluateClaims, and proofReceipt.",
  "covers": {
    "files": [
      "src/server/exec-verify.ts",
      "src/server/floor-recipe-engine.ts",
      "src/server/host-fact-log.ts",
      "src/server/oracle-invariants.ts",
      "src/server/proof-receipt.ts",
      "src/server/replay-verifier.ts",
      "src/server/verify-claims.ts"
    ],
    "classes": [
      "cross_tenant_read",
      "bola",
      "authorization"
    ]
  },
  "canonicalLabel": {
    "cwe": "CWE-639",
