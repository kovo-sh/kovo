    "title": "Cross-tenant read of victim tenant billing record",
    "impact": "Tenant-B member reads Tenant-A billing record containing victim email and account identifier.",
    "claimedImpact": "authorization",
    "claimedBoundary": "access",
    "vulnClass": "cross_tenant_read"
  },
  "freeTextLabel": {
    "title": "Cross-tenant unauthorized read of another tenant's billing record"
  },
